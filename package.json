{
  "name": "ingtalk",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "test:db": "npx supabase@2.114.0 start && npx supabase@2.114.0 test db --local",
    "test:security": "npm run typecheck && npm test && npm run admin:test && npm run admin:build && npm run test:db",
    "postinstall": "node scripts/ensure-sentry-cli-executable.cjs",
    "eas-build-post-install": "node scripts/ensure-sentry-cli-executable.cjs",
    "admin": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "admin:test": "npm --prefix admin test"
  },
  "dependencies": {
    "@sentry/cli": "2.55.0",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "^54.0.37",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.7.1",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
