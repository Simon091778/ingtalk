{
  "expo": {
    "name": "Ingtalk",
    "slug": "ingtalk",
    "scheme": "ingtalk",
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F45167"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "userInterfaceStyle": "light",
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "kr.ingtalk.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "Ingtalk uses your location only while you use the app to suggest nearby conversation partners."
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "kr.ingtalk.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F45167"
      },
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/ingtalk_default_alarm.wav"
          ],
          "defaultChannel": "messages-v3"
        }
      ],
      "./plugins/withChatNotificationGrouping",
      "./plugins/withPhoneNumberHint",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ingtalk uses your location only while you use the app to suggest nearby conversation partners.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ingtalk accesses only the photos you choose for profiles, posts, and chats.",
          "cameraPermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2857738057928315~4500634700",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ],
      "@sentry/react-native/expo",
      [
        "expo-audio",
        {
          "microphonePermission": "음성 메시지를 녹음하려면 마이크 권한이 필요합니다."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "490af075-02d5-4643-95ef-a9477b5d156c"
      }
    },
    "owner": "yongilnim1",
    "updates": {
      "url": "https://u.expo.dev/490af075-02d5-4643-95ef-a9477b5d156c"
    }
  }
}
