{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "phone-auth-preview": {
      "distribution": "internal",
      "environment": "production",
      "channel": "phone-auth-preview",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "production": {},
    "closed-test": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    }
  }
}
